{
  "name": "youngro",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @youngro/design-tokens build",
    "build": "turbo run build",
    "predev": "pnpm --filter @youngro/design-tokens build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter web dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "validate": "pnpm run format && turbo run lint check-types test",
    "clean": "rimraf --glob .turbo node_modules \"apps/**/.next\" \"apps/**/node_modules\" \"packages/**/dist\" \"packages/**/node_modules\"",
    "prepare": "husky",
    "commit": "git-cz"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@types/react": "19.1.0",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.6.2",
    "rimraf": "^4.0.1",
    "turbo": "^2.5.8",
    "typescript": "5.9.2",
    "yaml": "^2.8.1"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.0",
      "@types/react-dom": "19.1.1"
    }
  }
}
