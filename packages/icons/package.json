{
  "name": "@youngro/icons",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "node ./src/build-icons.mjs",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm exec eslint src/build-icons.mjs --max-warnings 0"
  },
  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-prettier": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/react": "19.1.0",
    "typescript": "5.9.2"
  },
  "exports": {
    ".": {
      "types": "./src/generated/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./src/generated/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist": {
      "types": "./src/generated/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "src/generated/index.d.ts"
}
