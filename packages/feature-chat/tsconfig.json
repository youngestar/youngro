{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@youngro/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "rootDir": "./src",
    "outDir": "dist",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
